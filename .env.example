# ==============================================================================
# DELTA EXCHANGE TRADING BOT - CONFIGURATION
# ==============================================================================

# Mode: 'paper' (simulated fills, zero financial risk) or 'live'
TRADING_MODE=paper

# Delta Exchange API Endpoint:
# India: https://api.india.delta.exchange (default)
# Global: https://api.delta.exchange
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange

# API Credentials (Optional for Paper Trading; Required for Live Trading)
DELTA_API_KEY=
DELTA_API_SECRET=

# Initial Paper Capital in USD (Virtual USDT balance)
PAPER_INITIAL_CAPITAL=10000.0

# Risk Management Settings (Hard Limits)
RISK_PER_TRADE_USD=50.0
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_USD=-150.0
DAILY_PROFIT_TARGET_USD=300.0
MAX_POSITION_VALUE_USD=2500.0

# Watchlist (Comma-separated Delta Exchange symbols)
# Supports Crypto (BTCUSD, ETHUSD) and Tokenized Stocks (AAPLXUSD, NVDAXUSD, TSLAXUSD)
WATCHLIST=BTCUSD,ETHUSD,AAPLXUSD,NVDAXUSD,TSLAXUSD

# Strategy Parameters
CANDLE_TIMEFRAME=15m
FAST_EMA=9
SLOW_EMA=21
TREND_EMA=200
RR_RATIO=1.5
TRAILING_STOP_ENABLED=True
BREAKEVEN_AT_R=1.0
POLL_INTERVAL_SECONDS=30
